#!/bin/zsh
# makleen: find what is eating disk space on a dev Mac, pick what to clean, reclaim it safely.
#
# Usage:
#   makleen                          scan, then pick what to clean from a checklist
#   makleen scan [CATEGORY...]       print a report and exit, nothing is changed
#   makleen clean [CATEGORY...]      scan + checklist for the given categories
#   makleen quarantine               list quarantined batches
#   makleen restore BATCH            put a quarantined batch back
#   makleen purge [--older-than N | --all]
#   makleen schedule install|remove  weekly report notification (launchd), never deletes
#
# Categories: leftovers caches projects extras
#
# Options:
#   --only TEXT   preselect only items whose name or path contains TEXT
#   --days N      projects count as idle after N days without use
#   --dry-run     show what would be cleaned and stop
#   --yes         skip the checklist and confirmation, clean the default selection
#   --all         scan: list every item; purge: purge every batch
#
# Checklist keys: up/down or j/k move, space selects, a toggles the section, enter continues, q quits
#
# Config: ~/.config/makleen/config.zsh (plain zsh, see config.example.zsh)
# Catalog: catalog.zsh lists the caches makleen knows; add your own in ~/.config/makleen/catalog.zsh

emulate zsh
setopt extended_glob null_glob pipefail
# String widths (bars, …) are counted in characters only under a UTF-8 locale.
[[ ${LC_ALL:-${LC_CTYPE:-$LANG}} == *[Uu][Tt][Ff]-#8* ]] || export LC_CTYPE=en_US.UTF-8
zmodload zsh/datetime
zmodload -F zsh/stat b:zstat

VERSION=0.2.0
SCRIPT=${0:A}
STATE_DIR=${MAKLEEN_HOME:-$HOME/.makleen}
QUARANTINE_DIR=$STATE_DIR/quarantine
LOG_DIR=${SCRIPT:h}/logs  # one log per run, named by date and time; next to the real script, not a symlink
CONFIG_FILE=${MAKLEEN_CONFIG:-$HOME/.config/makleen/config.zsh}
CATALOG_FILE=${SCRIPT:h}/catalog.zsh
USER_CATALOG=${MAKLEEN_CATALOG:-$HOME/.config/makleen/catalog.zsh}  # your own entries, same format
AGENT_LABEL=dev.makleen.weekly
AGENT_PLIST=$HOME/Library/LaunchAgents/$AGENT_LABEL.plist
LSREGISTER=/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister

# ---- defaults, overridden by $CONFIG_FILE ----
INACTIVE_DAYS=60
PROJECT_ROOTS=()      # empty: any folder in ~ that holds several git repos
PROTECT=()            # glob patterns of project paths whose artifacts are never touched
EXTRAS=()             # extras selected by default in the checklist
LEFTOVER_IGNORE=()    # glob patterns of ~/Library entry names never reported as leftovers
NEVER_TOUCH=()        # lowercase globs: matching paths are never reported, moved or deleted
UNUSED_APP_DAYS=90
QUARANTINE_DAYS=14
[[ -r $CONFIG_FILE ]] && source $CONFIG_FILE

# The parts live in lib/ next to the real file; ${0:A} resolves symlinks such as ~/.local/bin/makleen.
for part in common leftovers caches projects extras scan report checklist clean quarantine schedule; do
  source ${SCRIPT:h}/lib/$part.zsh || { print -ru2 -- "makleen: missing ${SCRIPT:h}/lib/$part.zsh"; exit 1 }
done
unset part

usage() { sed -n '2,/^$/s/^# \{0,1\}//p' $SCRIPT }

main() {
  local cmd= a
  case ${1:-} in
    scan|clean|quarantine|restore|purge|schedule|notify) cmd=$1; shift ;;
    help|-h|--help) usage; return ;;
    version|--version) say "makleen $VERSION"; return ;;
  esac
  CATS=() ONLY= DRY_RUN=0 ASSUME_YES=0 SHOW_ALL=0 PURGE_ALL=0 PURGE_DAYS=$QUARANTINE_DAYS
  local -a args
  while (( $# )); do
    case $1 in
      --only)       ONLY=$2; shift ;;
      --days)       INACTIVE_DAYS=$2; shift ;;
      --older-than) PURGE_DAYS=$2; shift ;;
      --dry-run|-n) DRY_RUN=1 ;;
      --yes|-y)     ASSUME_YES=1 ;;
      --all)        SHOW_ALL=1 PURGE_ALL=1 ;;
      -*)           die "unknown option: $1" ;;
      *)            args+=($1) ;;
    esac
    shift
  done
  if [[ -z $cmd ]]; then  # plain `makleen`: checklist in a terminal, report otherwise
    if (( ASSUME_YES || DRY_RUN )) || [[ -t 0 && -t 1 ]]; then cmd=clean; else cmd=scan; fi
  fi
  case $cmd in
    scan|clean)
      for a in $args; do (( ${ALL_CATEGORIES[(Ie)$a]} )) || die "unknown category: $a (use: $ALL_CATEGORIES)"; done
      (( $#args )) && CATS=($args) || CATS=($ALL_CATEGORIES)
      collect_all
      if [[ $cmd == scan ]]; then print_report; else do_clean; fi
      ;;
    quarantine) cmd_quarantine ;;
    restore)    cmd_restore ${args[1]:-} ;;
    purge)      cmd_purge ;;
    schedule)   cmd_schedule ${args[1]:-} ;;
    notify)     cmd_notify ;;
  esac
}

main "$@"
